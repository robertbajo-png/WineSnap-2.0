# Owned Supabase Edge Function secrets ONLY. Never put real values in Git.
# Supabase supplies its URL and service-role credentials to hosted functions.
OPENAI_API_KEY=REPLACE_IN_EDGE_SECRET_MANAGER
GEMINI_API_KEY=REPLACE_IN_EDGE_SECRET_MANAGER
OPENAI_LABEL_MODEL=gpt-6.1-sol
GEMINI_FAST_MODEL=gemini-3.8-flash

# Keep operational gates OFF until coordinated staging acceptance.
WINE_IMAGE_PROXY_ENABLED=false
PRIVACY_DELETION_ENABLED=false
# See docs/privacy-operations.md for all maintenance/export prerequisites.
