FROM cloudflare/cloudflared@sha256:faa8e0a1475f137c910be6025f43c8e4092fdd35461b31e19fd1390657a1ff39 AS connector
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
WORKDIR /app
COPY --from=connector /usr/local/bin/cloudflared /usr/local/bin/cloudflared
COPY --from=connector /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY scripts/lib/owned-tunnel.mjs scripts/lib/owned-backend.mjs scripts/lib/owned-internet.mjs ./lib/
COPY config/owned-windows/tunnel-entry.mjs ./entry.mjs
USER 1000:1000
ENTRYPOINT ["node", "/app/entry.mjs"]
CMD []
