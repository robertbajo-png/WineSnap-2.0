# Public build-time values only. Copy to .env.local in THIS directory.
# Never put provider keys, service-role keys or CRON_SECRET in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR-OWNED-STAGING-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_PRIVACY_CONTROLS_ENABLED=false
VITE_PRIVACY_OPERATIONS_VERIFIED=false
# Separate operator sign-off for supplier accounts, agreements and transfer assessment.
# Working export/erasure does not establish this; see docs/supplier-privacy-review-2026-10-25.md.
VITE_PRIVACY_SUPPLIERS_VERIFIED=false
VITE_WINE_IMAGE_PROXY_ENABLED=false
# Local Windows test adapter only; forbidden with any other backend.
VITE_LOCAL_AI_ENABLED=false
# Test cooking requires privacy controls and verified export/erasure operations.
# Supplier sign-off is separate and remains false during isolated test development.
VITE_COOKING_CORE_ENABLED=false
VITE_AI_CHEF_ENABLED=false
VITE_MEALS_ENABLED=false
VITE_RECIPE_NUTRITION_ENABLED=false
